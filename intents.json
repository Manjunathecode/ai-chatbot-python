{
    "intents": [
        {
            "tag": "greeting",
            "patterns": [
                "Hello",
                "Hi",
                "Hey",
                "Good morning",
                "Good evening",
                "Whats up",
                "How are you",
                "hi there",
                "hello there",
                "hey there",
                "good afternoon",
                "greetings",
                "sup"
            ],
            "responses": [
                "Hello! This is a portfolio support-chatbot demo. What would you like to try?",
                "Hi there! Ask a fictional support question to see intent classification in action.",
                "Hey! I can demonstrate support intents such as orders, payments, appointments, and basic troubleshooting."
            ]
        },
        {
            "tag": "goodbye",
            "patterns": [
                "Bye",
                "Goodbye",
                "See you",
                "Take care",
                "Exit",
                "Quit",
                "bye bye",
                "see you later",
                "good night",
                "talk later"
            ],
            "responses": [
                "Goodbye! Have a great day!",
                "Thanks for trying the chatbot demo. Goodbye!",
                "Take care! You can return whenever you want to test another sample intent."
            ]
        },
